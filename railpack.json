{
  "$schema": "https://schema.railpack.com",
  "provider": "php",
  "packages": {
    "php": "8.3",
    "phpExtensions": ["pdo_mysql", "pdo", "mbstring", "curl", "openssl", "session", "json"]
  },
  "steps": {
    "install": {
      "commands": [
        "composer install --no-dev --optimize-autoloader --no-interaction"
      ]
    }
  },
  "deploy": {
    "startCommand": "php -S 0.0.0.0:$PORT router.php"
  }
}