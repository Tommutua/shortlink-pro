; =====================================================
; ShortLink Pro — Environment Template
; =====================================================
; Copy this file to ".env" and fill in your real values.
;   cp .env.example .env
;
; The .env file is gitignored. This template IS committed
; so other developers know which variables are required.
; =====================================================

; -----------------------------------------------------
; APPLICATION
; -----------------------------------------------------
APP_NAME="ShortLink Pro"
APP_URL="http://localhost/shortlink-pro"
APP_ENV="local"          ; local | staging | production
APP_DEBUG=true           ; true | false

; -----------------------------------------------------
; DATABASE
; -----------------------------------------------------
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_NAME="shortlink"
DB_USER="root"
DB_PASS=""               ; Leave empty for XAMPP default

; -----------------------------------------------------
; SECURITY
; -----------------------------------------------------
; Generate with: php -r "echo bin2hex(random_bytes(32));"
APP_SECRET=""

; -----------------------------------------------------
; RATE LIMITING
; -----------------------------------------------------
RATE_LIMIT_LINKS_PER_HOUR=20
RATE_LIMIT_PASSWORD_ATTEMPTS=5

; -----------------------------------------------------
; GEOLOCATION
; -----------------------------------------------------
GEO_API_URL="http://ip-api.com/json"

; -----------------------------------------------------
; TIMEZONE
; -----------------------------------------------------
APP_TIMEZONE="Africa/Nairobi"